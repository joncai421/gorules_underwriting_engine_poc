{
  "name": "uw-gorules-poc",
  "version": "1.0.0",
  "private": true,
  "description": "Headless Underwriting Engine PoC: legacy Java migration to GoRules TS (zen-engine) + AI Copilot + JDM Admin UI",
  "workspaces": [
    "gorules-ts-engine",
    "gorules-admin-ui"
  ],
  "scripts": {
    "dev": "concurrently -n engine,ui -c cyan,magenta \"npm run dev -w gorules-ts-engine\" \"npm run dev -w gorules-admin-ui\"",
    "engine": "npm run dev -w gorules-ts-engine",
    "ui": "npm run dev -w gorules-admin-ui",
    "migrate": "npm run migrate -w gorules-ts-engine",
    "migrate:llm": "npm run migrate:llm -w gorules-ts-engine",
    "gen:xlsx": "npm run gen:xlsx -w gorules-ts-engine",
    "verify-parity": "npm run verify-parity -w gorules-ts-engine",
    "selftest": "npm run selftest -w gorules-ts-engine",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w gorules-ts-engine",
    "db:seed": "npm run db:seed -w gorules-ts-engine",
    "build": "npm run build -w gorules-admin-ui"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
