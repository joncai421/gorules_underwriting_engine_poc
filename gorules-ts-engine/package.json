{
  "name": "gorules-ts-engine",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Headless GoRules (zen-engine) underwriting engine + migration/parity tooling + AI copilot",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/tools/astToJdmMigrator.ts",
    "migrate:llm": "tsx src/tools/astToJdmMigrator.ts --llm-prompt",
    "gen:xlsx": "tsx src/tools/makeSampleXlsx.ts",
    "verify-parity": "tsx src/tools/parityVerifier.ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "selftest": "tsx src/tests/engineSelfTest.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@gorules/zen-engine": "^2.1.7",
    "fastify": "^5.12.7",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
