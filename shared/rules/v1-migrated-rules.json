    {
      "id": "node-aggregator",
      "name": "Decision Aggregator",
      "type": "functionNode",
      "position": {
        "x": 620,
        "y": 200
      },
      "content": {
        "source": "export const handler = async (input) => {\n  const raw = Array.isArray(input) ? input : (input && Array.isArray(input.matches)) ? input.matches : (input ? [input] : []);\n  const matches = raw.filter(m => m && m.ruleId);\n  const uniqueRules = new Map();\n  for (const m of matches) {\n    if (!uniqueRules.has(m.ruleId)) uniqueRules.set(m.ruleId, m);\n  }\n  const rules = Array.from(uniqueRules.values());\n  const hasDecline = rules.some(r => r.ruleDecision === 'DECLINE');\n  const hasUnclean = rules.some(r => r.ruleDecision === 'UNCLEAN');\n  let decision = 'CLEAN';\n  if (hasDecline) decision = 'DECLINE';\n  else if (hasUnclean) decision = 'UNCLEAN';\n  const basePremiumLoadingPct = decision === 'DECLINE' ? 0 : rules.reduce((acc, r) => acc + (Number(r.loadingPct) || 0), 0);\n  const triggeredRules = rules.length > 0\n    ? rules.map(r => ({ ruleId: r.ruleId, category: r.category, reason: r.reason }))\n    : [{ ruleId: 'RULE_STANDARD_CLEAN', category: 'STANDARD', reason: 'Standard clean acceptance' }];\n  return { decision, basePremiumLoadingPct, triggeredRules };\n};"
      }
