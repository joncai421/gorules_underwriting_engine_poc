{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "10 canonical applicant payloads shared between the legacy Java service and the GoRules TS engine. expectedV1 = authoritative parity baseline produced by the migrated v1 rules (and the legacy Java service). expectedV2 shows the effect of the 1-click onboarded rules.",
  "cases": [
    {
      "id": "CASE-01",
      "label": "Healthy Clean",
      "applicant": {
        "applicantId": "APP-1001",
        "age": 30,
        "bmi": 22.0,
        "smoker": false,
        "systolicBp": 118,
        "sumAssured": 300000,
        "medicalConditions": [],
        "occupationClass": 1
      },
      "expectedV1": { "decision": "CLEAN", "basePremiumLoadingPct": 0, "triggeredRuleIds": ["RULE_STANDARD_CLEAN"] },
      "expectedV2": { "decision": "CLEAN", "basePremiumLoadingPct": 0, "triggeredRuleIds": ["RULE_STANDARD_CLEAN"] }
    },
    {
      "id": "CASE-02",
      "label": "Mild Overweight Auto-Loading",
      "applicant": {
        "applicantId": "APP-1002",
        "age": 35,
        "bmi": 26.0,
        "smoker": false,
        "systolicBp": 125,
        "sumAssured": 400000,
        "medicalConditions": [],
        "occupationClass": 2
      },
      "expectedV1": { "decision": "CLEAN", "basePremiumLoadingPct": 10, "triggeredRuleIds": ["RULE_MILD_OVERWEIGHT_CLEAN"] },
      "expectedV2": { "decision": "CLEAN", "basePremiumLoadingPct": 10, "triggeredRuleIds": ["RULE_MILD_OVERWEIGHT_CLEAN"] }
    },
    {
      "id": "CASE-03",
