      "expectedV1": { "decision": "DECLINE", "basePremiumLoadingPct": 0, "triggeredRuleIds": ["RULE_AGE_KNOCKOUT"] },
      "expectedV2": { "decision": "DECLINE", "basePremiumLoadingPct": 0, "triggeredRuleIds": ["RULE_AGE_KNOCKOUT"] }
    },
    {
