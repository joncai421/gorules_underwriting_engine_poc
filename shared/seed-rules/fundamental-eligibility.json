      "name": "A.9 Fundamental Outcome Aggregator",
      "type": "functionNode",
      "position": {
        "x": 640,
        "y": 240
      },
      "content": {
        "source": "export const handler = async (input) => {\n  const violations = (input.violations || []).map((v) => ({\n    ruleId: v.ruleId,\n    fundamentalDecision: v.fundamentalDecision,\n    missingDoc: v.missingDoc || null,\n    reason: v.reason\n  }));\n  const hasDecline = violations.some((v) => v.fundamentalDecision === 'DECLINE');\n  const hasRequestInfo = violations.some((v) => v.fundamentalDecision === 'REQUEST_ADDITIONAL_INFO');\n  return {\n    applicantId: input.applicantId,\n    fundamentalPassed: violations.length === 0,\n    finalDecision: hasDecline ? 'DECLINE' : (hasRequestInfo ? 'REQUEST_ADDITIONAL_INFO' : 'PASS'),\n    riskClass: hasDecline ? 'FUNDAMENTAL_KNOCKOUT' : (hasRequestInfo ? 'INCOMPLETE_FUNDAMENTAL_KYC' : 'ELIGIBLE'),\n    violations: violations\n  };\n};"
      }
    },
